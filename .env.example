# Copy to .env. Do not commit real credentials.
# Local development defaults are safe for localhost only.  Production must set
# APP_ENV=production, SESSION_HTTPS_ONLY=true, and a random APP_SECRET.
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
SESSION_HTTPS_ONLY=false
# Keep false in company deployments. Use scripts/manage_users.py to create
# accounts; turn this on only for a short, controlled local bootstrap window.
ALLOW_SELF_REGISTRATION=false
# Optional emergency bootstrap for existing users. Prefer manage_users.py.
ADMIN_USERNAMES=
# Authentication provider: local (current demo), hybrid (local + UniPortal),
# or oauth2 (UniPortal only). The Huawei flow uses OAuth 2.0 Authorization
# Code + PKCE and a UserInfo API; it does not use OIDC ID Tokens.
AUTH_PROVIDER=local
OAUTH_PROVIDER_ID=huawei-idaas
OAUTH_PROVIDER_NAME=华为 UniPortal
# These are the only two mandatory OAuth application credentials. Store the
# real secret only in the protected production .env or company secret store.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Defaults to ${APP_BASE_URL}/authorize and must exactly match the callback
# registered for the Huawei application.
OAUTH_REDIRECT_URI=
# UniPortal defaults are built in. Uncomment only if the approved company Demo
# confirms that Token or UserInfo uses another path.
# OAUTH_AUTHORIZATION_URL=https://uniportal.huawei.com/saaslogin1/oauth2/authorize
# OAUTH_TOKEN_URL=https://uniportal.huawei.com/saaslogin1/oauth2/token
# OAUTH_USERINFO_URL=https://uniportal.huawei.com/saaslogin1/oauth2/userinfo
OAUTH_SCOPE=profile
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OAUTH_SUBJECT_CLAIMS=sub,uid,user_id,id,employee_id,employeeId
OAUTH_USERNAME_CLAIMS=preferred_username,employee_id,employeeId,uid,email,sub
OAUTH_EMAIL_CLAIMS=email,mail
OAUTH_DISPLAY_NAME_CLAIMS=name,display_name,cn,preferred_username
OAUTH_GROUP_CLAIMS=groups,roles,group
OAUTH_ADMIN_GROUPS=
OAUTH_REVIEWER_GROUPS=
# Highest administrator employee IDs. The server defaults are j00983211 and
# j00456121;
# override with a comma-separated allowlist only when ownership changes.
OAUTH_SUPER_ADMIN_EMPLOYEE_IDS=j00983211,j00456121
OAUTH_AUTO_PROVISION=true
# Keep false unless an administrator has reviewed the username-linking plan.
OAUTH_AUTO_LINK_LOCAL=false
# Keep false when roles are managed locally; set true to sync configured groups.
OAUTH_SYNC_ROLES=false
OAUTH_HTTP_TIMEOUT=10
OAUTH_END_SESSION_URL=
# Local review uses 127.0.0.1. In production replace this with the HTTPS URL
# opened from Windows, for example https://bmc-hub.internal.example.
APP_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=200
# Optional legacy Office importer. DOCX/PPTX/Markdown/TXT work without it.
# Set the path if soffice is not on PATH; legacy DOC/PPT then convert locally.
CASE_IMPORT_SOFFICE=soffice
# Safety limits for Office Open XML imports (uncompressed archive and extracted text).
CASE_IMPORT_MAX_UNCOMPRESSED_MB=30
CASE_IMPORT_MAX_TEXT_CHARS=1500000
# Optional trusted in-network BMC parser, configured as module:function.
# Example: app.skills.company_bmc:analyze_log_bundle
BMC_SKILL_ADAPTER=
# Comma-separated usernames allowed to record requirement-review decisions.
REQUEST_REVIEWERS=demo-maintainer
# Displayed review rhythm. Use 每周 or 每两周 according to the team process.
REQUEST_REVIEW_CADENCE=每周
LLM_API_KEY=
# OpenAI-compatible example. DeepSeek uses https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional administrator-switchable profiles. Each api_key_env points to an
# environment variable on this server; do not put the key itself in JSON.
# LLM_PROFILES_JSON=[{"id":"deepseek-flash","name":"DeepSeek Flash","base_url":"https://api.deepseek.com","model":"deepseek-v4-flash","api_key_env":"LLM_DEEPSEEK_FLASH_KEY"},{"id":"deepseek-pro","name":"DeepSeek Pro","base_url":"https://api.deepseek.com","model":"deepseek-v4-pro","api_key_env":"LLM_DEEPSEEK_PRO_KEY"}]
LLM_PROFILES_JSON=
LLM_ACTIVE_PROFILE=default
LLM_DEEPSEEK_FLASH_KEY=
LLM_DEEPSEEK_PRO_KEY=
# 仅由公司内网桥接服务使用；不得放入浏览器、SQLite 或 Git。
WELINK_AGENT_BRIDGE_URL=
WELINK_AGENT_BRIDGE_TOKEN=
WELINK_DEFAULT_MODE=demo
# Set to 1 only when Windows users will pair a local connector. The server
# then queues jobs and never executes welink-cli or stores a WeLink login.
WELINK_CONNECTOR_ENABLED=0
