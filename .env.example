# Copy to .env. Do not commit real credentials.
# Local development defaults are safe for localhost only.  Production must set
# APP_ENV=production, SESSION_HTTPS_ONLY=true, and a random APP_SECRET.
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
SESSION_HTTPS_ONLY=false
# Keep false in company deployments. Use scripts/manage_users.py to create
# accounts; turn this on only for a short, controlled local bootstrap window.
ALLOW_SELF_REGISTRATION=false
# Optional emergency bootstrap for existing users. Prefer manage_users.py.
ADMIN_USERNAMES=
APP_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=200
# Optional legacy Office importer. DOCX/PPTX/Markdown/TXT work without it.
# Set the path if soffice is not on PATH; legacy DOC/PPT then convert locally.
CASE_IMPORT_SOFFICE=soffice
# Safety limits for Office Open XML imports (uncompressed archive and extracted text).
CASE_IMPORT_MAX_UNCOMPRESSED_MB=30
CASE_IMPORT_MAX_TEXT_CHARS=1500000
# Optional trusted in-network BMC parser, configured as module:function.
# Example: app.skills.company_bmc:analyze_log_bundle
BMC_SKILL_ADAPTER=
# Comma-separated usernames allowed to record requirement-review decisions.
REQUEST_REVIEWERS=demo-maintainer
# Displayed review rhythm. Use 每周 or 每两周 according to the team process.
REQUEST_REVIEW_CADENCE=每周
LLM_API_KEY=
# OpenAI-compatible example. DeepSeek uses https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
